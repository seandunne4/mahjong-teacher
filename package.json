{
  "name": "mahjong-teacher",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @mj/web",
    "build": "npm run build -w @mj/web",
    "preview": "npm run preview -w @mj/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p packages/engine/tsconfig.json && tsc -p apps/web/tsconfig.json"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.15.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
