  { "id": "4p", "group": "suit", "suit": "dots", "rank": 4, "english": "Four of Dots", "short": "4 Dot", "hanzi": { "trad": "四筒", "simp": "四筒" }, "pinyin": { "marks": "sì tǒng", "numbered": "si4 tong3" }, "copies": 4, "faceNotes": "Four circles in a square, green and dark blue." },
