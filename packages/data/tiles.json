  { "id": "7m", "group": "suit", "suit": "characters", "rank": 7, "english": "Seven of Characters", "short": "7 Crak", "hanzi": { "trad": "七萬", "simp": "七万" }, "pinyin": { "marks": "qī wàn", "numbered": "qi1 wan4" }, "copies": 4, "faceNotes": "七 looks like a cross with a hooked tail, above a red 萬.", "lookAlikes": ["9m"] },
