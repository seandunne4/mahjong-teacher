  { "id": "4s", "group": "suit", "suit": "bamboo", "rank": 4, "english": "Four of Bamboo", "short": "4 Bam", "hanzi": { "trad": "四索", "simp": "四索" }, "pinyin": { "marks": "sì suǒ", "numbered": "si4 suo3" }, "copies": 4, "faceNotes": "Four green sticks in a square." },
